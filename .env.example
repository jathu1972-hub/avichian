# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://avichian_app:CHANGE_ME@localhost:5432/avichian?schema=public

# ─── JWT & Encryption ───────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_random_string
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key_for_field_encryption

# ─── App ────────────────────────────────────────────────────
# APP_ENV=development disables permanent login lockout (see LOCKOUT_ENABLED)
APP_ENV=development
NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed by CORS (include Netlify + custom domains in production)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174
# Production example:
# FRONTEND_URLS=https://avichian.netlify.app,https://admin.avichian.netlify.app,https://app.avichian.in,https://admin.avichian.in

APP_URL=http://localhost:5173
SUPER_ADMIN_PORTAL_URL=http://localhost:5174
# Production example:
# APP_URL=https://app.avichian.in
# SUPER_ADMIN_PORTAL_URL=https://admin.avichian.in

# Frontend (copy to frontend/.env or set in Vite)
# VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=
COLLEGE_EMAIL_DOMAIN=avichi.edu

# ─── Student master import ───────────────────────────────────
STUDENT_MASTER_SEED_PATH=./seed-data/student_master.json

# ─── OTP / SMS ──────────────────────────────────────────────
# console (dev terminal) | appwrite (real SMS) | msg91 (India)
SMS_PROVIDER=console
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
OTP_EXPIRY_MINUTES=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=30
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=AVICHI
FIREBASE_PROJECT_ID=

# ─── SMTP (college-domain OTP email) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@avichi.edu

# ─── Security ───────────────────────────────────────────────
# Development: lockout disabled by default. Set LOCKOUT_ENABLED=true to test soft lock (30s).
# Production: lock after 5 failures for 15 minutes.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
# LOCKOUT_ENABLED=false

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── Super Admin bootstrap (first-run only) ─────────────────
SUPER_ADMIN_REG_NO=ADMIN001
SUPER_ADMIN_PASSWORD=ChangeMe2025!
SUPER_ADMIN_EMAIL=admin@avichi.edu

# ─── Public API URL (absolute media links for Netlify frontends) ──
PUBLIC_API_URL=http://localhost:4000
# Production:
# PUBLIC_API_URL=https://api.avichian.in

# ─── Cloudflare R2 (production media storage) ───────────────
# When set, uploads go to R2. When empty, files are stored under backend/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional aliases some hosts use:
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=

# JWT (backend secrets — never put these in Netlify frontend env)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=