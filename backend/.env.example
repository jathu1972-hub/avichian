# ─── AVICHIAN Backend (Railway / Render / Fly / VPS) ───
# NEVER put these in Netlify frontend env.

# Database (Neon / Supabase / Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/avichian?schema=public&sslmode=require

# JWT — prefer long random strings (≥32 chars)
# Aliases accepted: JWT_SECRET, REFRESH_SECRET
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_random_string
# JWT_SECRET=
# REFRESH_SECRET=

ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key_for_field_encryption

APP_ENV=production
NODE_ENV=production
PORT=4000

# CORS — every frontend origin (no trailing slash)
# Alias: CORS_ORIGIN
FRONTEND_URLS=https://avichian.netlify.app,https://admin-avichian.netlify.app,https://app.avichian.in,https://admin.avichian.in
# CORS_ORIGIN=https://avichian.netlify.app,https://admin-avichian.netlify.app

APP_URL=https://app.avichian.in
SUPER_ADMIN_PORTAL_URL=https://admin.avichian.in
PUBLIC_API_URL=https://api.avichian.in

COLLEGE_EMAIL_DOMAIN=avichi.edu

# Cloudflare R2 (media). Leave empty to use local ./uploads (not ideal in multi-instance).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Aliases:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=

# SMTP (optional college email OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@avichi.edu

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# SMS OTP (console | appwrite | msg91)
SMS_PROVIDER=console
