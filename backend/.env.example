# ─── AVICHIAN Backend (Railway / Render / Fly / VPS) ───
# NEVER put these in Netlify frontend env.

# Database (Neon / Supabase / Railway / Render PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/avichian?schema=public&sslmode=require

# JWT — prefer long random strings (≥32 chars)
# Aliases: JWT_SECRET, REFRESH_SECRET
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_random_string
# JWT_SECRET=
# REFRESH_SECRET=

ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key_for_field_encryption

APP_ENV=production
NODE_ENV=production
PORT=4000

# ── CORS / portals (production architecture) ──
# Prefer listing both SPAs:
FRONTEND_URLS=https://app.avichian.com,https://admin.avichian.com
# Or split (also merged into CORS):
FRONTEND_URL=https://app.avichian.com
ADMIN_URL=https://admin.avichian.com
APP_URL=https://app.avichian.com
SUPER_ADMIN_PORTAL_URL=https://admin.avichian.com
# CORS_ORIGIN=https://app.avichian.com,https://admin.avichian.com

# Public API origin (media absolute URLs, links)
PUBLIC_API_URL=https://api.avichian.com
# API_URL=https://api.avichian.com

COLLEGE_EMAIL_DOMAIN=avichi.edu

# Cloudflare R2 (required for multi-instance media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Aliases:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=

# One-time Super Admin bootstrap (npm run seed:admin)
SUPER_ADMIN_REG_NO=ADMIN001
SUPER_ADMIN_EMAIL=admin@avichi.edu
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# SMS OTP (console | appwrite | msg91) — console logs OTP in server logs
SMS_PROVIDER=console

# ── Voice / Video (WebRTC + optional LiveKit + Coturn) ──
# STUN (defaults to Google if unset)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# Coturn TURN — required for reliable production calls across mobile NATs
# TURN_URLS=turn:turn.avichian.com:3478?transport=udp,turn:turn.avichian.com:3478?transport=tcp
# TURN_USERNAME=avichian
# TURN_CREDENTIAL=CHANGE_ME
# Aliases: COTURN_URL, COTURN_USERNAME, COTURN_PASSWORD
#
# Optional LiveKit SFU (preferred for scale; skips mesh WebRTC)
# LIVEKIT_URL=wss://avichian-xxxxx.livekit.cloud
# LIVEKIT_API_KEY=APIxxxx
# LIVEKIT_API_SECRET=secretxxxx

