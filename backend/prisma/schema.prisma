generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  STAFF
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  UNVERIFIED
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  MFA
}

enum OtpChannel {
  SMS
  EMAIL
}

enum LoginMethod {
  PASSWORD
  OTP
  MFA
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  REGISTRATION
  PASSWORD_RESET
  PASSWORD_CHANGE
  ACCOUNT_LOCKED
  MFA_ENABLED
  MFA_VERIFIED
  STUDENT_MASTER_IMPORT
  SESSION_REFRESH
  SESSION_REVOKED
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_ACTIVATED
  USER_DELETED
  CONTENT_DELETED
  CONTENT_RESTORED
  REPORT_REVIEWED
  REPORT_CLOSED
  ANNOUNCEMENT_PUBLISHED
  EVENT_PUBLISHED
  USER_WARNED
  CONTENT_ARCHIVED
  CONTENT_REPORTED
}

enum ContentReportReason {
  SPAM
  HARASSMENT
  BULLYING
  VIOLENCE
  FAKE_ACCOUNT
  ADULT_CONTENT
  ILLEGAL_CONTENT
  SCAM
  INAPPROPRIATE
  OTHER
}

enum ContentReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  CLOSED
}

enum ContentReportTarget {
  POST
  STORY
  MESSAGE
  USER
  COMMENT
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  DEPARTMENT
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PDF
  VOICE
  SYSTEM
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  MISSED
  REJECTED
  COMPLETED
  FAILED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  POST_LIKE
  COMMENT
  CALL_MISSED
  CALL_INCOMING
  EVENT
  ANNOUNCEMENT
  MESSAGE
}

enum StudentMasterStatus {
  ACTIVE
  INACTIVE
}

enum ProfilePrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentMaster StudentMaster[]
  users         User[]
  staff         Staff[]
  announcements Announcement[]
  events        DepartmentEvent[]

  @@map("departments")
}

model Announcement {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  title        String
  body         String
  visibility   String   @default("DEPARTMENT")
  year         Int?
  section      String?
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([createdAt])
  @@map("announcements")
}

model DepartmentEvent {
  id                   String    @id @default(uuid())
  departmentId         String    @map("department_id")
  name                 String
  description          String?
  startsAt             DateTime  @map("starts_at")
  endsAt               DateTime? @map("ends_at")
  venue                String?
  maxParticipants      Int?      @map("max_participants")
  registrationDeadline DateTime? @map("registration_deadline")
  visibility           String    @default("DEPARTMENT")
  published            Boolean   @default(true)
  bannerUrl            String?   @map("banner_url")
  createdById          String    @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([startsAt])
  @@map("department_events")
}

model StudentMaster {
  id              String              @id @default(uuid())
  regNo           String              @unique @map("reg_no")
  name            String
  mobileHash      String              @map("mobile_hash")
  mobileEnc       String              @map("mobile_enc")
  email           String
  departmentId    String              @map("department_id")
  year            Int
  section         String?
  status          StudentMasterStatus @default(ACTIVE)
  accountCreated  Boolean             @default(false) @map("account_created")
  role            UserRole            @default(STUDENT)
  verified        Boolean             @default(false)
  importedAt      DateTime            @default(now()) @map("imported_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  user       User?

  @@index([departmentId])
  @@index([email])
  @@index([mobileHash])
  @@index([status])
  @@index([accountCreated])
  @@map("student_master")
}

model User {
  id               String    @id @default(uuid())
  regNo            String    @unique @map("reg_no")
  passwordHash     String    @map("password_hash")
  email            String    @unique
  mobileHash       String    @unique @map("mobile_hash")
  mobileEnc        String    @map("mobile_enc")
  role             UserRole  @default(STUDENT)
  departmentId     String    @map("department_id")
  studentMasterId  String?   @unique @map("student_master_id")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastFailedLoginAt DateTime? @map("last_failed_login_at")
  accountStatus    AccountStatus @default(ACTIVE) @map("account_status")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc     String?   @map("mfa_secret_enc")
  online           Boolean   @default(false)
  lastSeen         DateTime? @map("last_seen")
  lastLoginAt      DateTime? @map("last_login_at")
  suspendedAt      DateTime? @map("suspended_at")
  deletedAt        DateTime? @map("deleted_at")
  forcePasswordChange Boolean @default(false) @map("force_password_change")
  verifiedBadge    Boolean   @default(false) @map("verified_badge")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  department    Department     @relation(fields: [departmentId], references: [id])
  studentMaster StudentMaster? @relation(fields: [studentMasterId], references: [id])
  profile       Profile?
  staff         Staff?
  admin         Admin?
  sessions      Session[]
  otpCodes      OtpCode[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  posts         Post[]
  postLikes     PostLike[]
  stories       Story[]
  reels         Reel[]
  reelLikes     ReelLike[]
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  conversationMembers ConversationMember[]
  messages            Message[]
  callsMade           CallHistory[] @relation("CallCaller")
  callsReceived       CallHistory[] @relation("CallReceiver")
  notifications       Notification[]
  reportsFiled        ContentReport[] @relation("ReportReporter")
  reportsAgainst      ContentReport[] @relation("ReportTargetUser")
  mediaAssets         MediaAsset[]
  hiddenContent       ContentHide[]
  postsDeleted        Post[]  @relation("PostDeletedBy")
  storiesDeleted      Story[] @relation("StoryDeletedBy")
  reelsDeleted        Reel[]  @relation("ReelDeletedBy")

  @@index([departmentId])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  name            String
  bio             String?
  year            Int?
  profilePhotoUrl String?        @map("profile_photo_url")
  coverPhotoUrl   String?        @map("cover_photo_url")
  privacy         ProfilePrivacy @default(PUBLIC)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Immutable metadata for every backend-accepted file upload.
model MediaAsset {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  fileName       String   @map("file_name")
  fileType       String   @map("file_type")
  fileSize       Int      @map("file_size")
  purpose        String
  storageKey     String   @map("storage_key")
  storageUrl     String   @map("storage_url")
  storageBackend String   @map("storage_backend")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([purpose])
  @@map("media_assets")
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  staffId      String   @unique @map("staff_id")
  departmentId String   @map("department_id")
  title        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("staff")
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  refreshTokenHash   String    @unique @map("refresh_token_hash")
  refreshTokenLookup String    @unique @map("refresh_token_lookup")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  deviceLabel        String?   @map("device_label")
  rememberMe         Boolean   @default(false) @map("remember_me")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  regNo     String?    @map("reg_no")
  mobile    String?
  email     String?
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  channel   OtpChannel
  attempts  Int        @default(0)
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([regNo])
  @@index([mobile])
  @@index([expiresAt])
  @@map("otp_codes")
}

model LoginHistory {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  regNo     String?     @map("reg_no")
  method    LoginMethod
  success   Boolean
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model AuditLog {
  id           String      @id @default(uuid())
  userId       String?     @map("user_id")
  action       AuditAction
  resourceType String?     @map("resource_type")
  resourceId   String?     @map("resource_id")
  metadata     Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Post {
  id          String         @id @default(uuid())
  authorId    String         @map("author_id") // ownerId
  caption     String?
  mediaUrl    String?        @map("media_url")
  visibility  PostVisibility @default(DEPARTMENT)
  isDeleted   Boolean        @default(false) @map("is_deleted")
  deletedAt   DateTime?      @map("deleted_at")
  deletedById String?        @map("deleted_by_id")
  archivedAt  DateTime?      @map("archived_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author    User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("PostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  likes     PostLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([isDeleted])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum StoryVisibility {
  PUBLIC
  FRIENDS
  DEPARTMENT
  PRIVATE
}

model Story {
  id          String          @id @default(uuid())
  userId      String          @map("user_id") // ownerId
  mediaUrl    String          @map("media_url")
  mediaType   StoryMediaType  @default(IMAGE) @map("media_type")
  caption     String?
  visibility  StoryVisibility @default(DEPARTMENT)
  isDeleted   Boolean         @default(false) @map("is_deleted")
  deletedAt   DateTime?       @map("deleted_at")
  deletedById String?         @map("deleted_by_id")
  expiresAt   DateTime        @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("StoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([visibility])
  @@index([isDeleted])
  @@map("stories")
}

model Reel {
  id          String         @id @default(uuid())
  authorId    String         @map("author_id") // ownerId
  caption     String?
  mediaUrl    String         @map("media_url")
  coverUrl    String?        @map("cover_url")
  visibility  PostVisibility @default(DEPARTMENT)
  isDeleted   Boolean        @default(false) @map("is_deleted")
  deletedAt   DateTime?      @map("deleted_at")
  deletedById String?        @map("deleted_by_id")
  archivedAt  DateTime?      @map("archived_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author    User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("ReelDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  likes     ReelLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("reels")
}

model ReelLike {
  id        String   @id @default(uuid())
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
  @@index([userId])
  @@map("reel_likes")
}

/// Per-user hide list (does not delete the content for others)
model ContentHide {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") // POST | STORY | REEL
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("content_hides")
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String              @map("sender_id")
  receiverId String              @map("receiver_id")
  status     FriendRequestStatus @default(PENDING)
  acceptedAt DateTime?           @map("accepted_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("friend_requests")
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  body           String?
  type           MessageType @default(TEXT)
  mediaUrl       String?     @map("media_url")
  seenAt         DateTime?   @map("seen_at")
  editedAt       DateTime?   @map("edited_at")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model CallHistory {
  id         String     @id @default(uuid())
  callerId   String     @map("caller_id")
  receiverId String     @map("receiver_id")
  type       CallType
  status     CallStatus @default(RINGING)
  duration   Int        @default(0)
  roomName   String?    @map("room_name")
  startedAt  DateTime   @default(now()) @map("started_at")
  endedAt    DateTime?  @map("ended_at")

  caller   User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([startedAt])
  @@map("call_history")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model ContentReport {
  id           String              @id @default(uuid())
  reporterId   String              @map("reporter_id")
  targetType   ContentReportTarget @map("target_type")
  targetId     String              @map("target_id")
  targetUserId String?             @map("target_user_id")
  reason       ContentReportReason
  details      String?
  status       ContentReportStatus @default(OPEN)
  adminNotes   String?             @map("admin_notes")
  resolvedById String?             @map("resolved_by_id")
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User? @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_reports")
}